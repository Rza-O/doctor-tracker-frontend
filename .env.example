# Base URL of the Express API (no trailing slash, no /api).
# Local: the backend running on your machine. Vercel: your Render URL,
# e.g. https://doctor-tracker-api.onrender.com
# Read by next.config.ts at build time for the /api proxy, so on Vercel it must
# be set before the build runs.
API_URL=http://localhost:4000
