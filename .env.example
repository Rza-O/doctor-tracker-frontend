# Base URL of the Express API (no trailing slash, no /api).
# Local: the backend running on your machine. Vercel: your Render URL,
# e.g. https://doctor-tracker-api.onrender.com
# Read by next.config.ts at build time for the /api proxy, so on Vercel it must
# be set before the build runs.
API_URL=http://localhost:4000

# Optional one-click demo logins on the sign-in page. These are PUBLIC by
# design (NEXT_PUBLIC_ values ship to the browser) — use only the seeded demo
# accounts, never real credentials. Leave empty to hide the demo buttons.
NEXT_PUBLIC_DEMO_ADMIN_EMAIL=
NEXT_PUBLIC_DEMO_ADMIN_PASSWORD=
NEXT_PUBLIC_DEMO_VIEWER_EMAIL=
NEXT_PUBLIC_DEMO_VIEWER_PASSWORD=
